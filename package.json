{
  "name": "dnova-for-copilot",
  "displayName": "DNova for Copilot Chat",
  "description": "Use DNova GLM-5.2 in Copilot Chat. Zero config, BYOK.",
  "icon": "resources/icon.png",
  "version": "0.0.3",
  "publisher": "luketebo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luketebo/DNova-for-copilot"
  },
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "dnova",
    "deloitte",
    "glm-5.2",
    "glm",
    "copilot",
    "github copilot",
    "copilot chat",
    "byok",
    "language model",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "enabledApiProposals": [],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "dnova",
        "displayName": "DNova"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "dnova.mcp-abap-adt",
        "label": "%dnova-copilot.mcp.abapAdt.providerLabel%"
      }
    ],
    "commands": [
      {
        "command": "dnova-copilot.setApiKey",
        "title": "%dnova-copilot.command.setApiKey%"
      },
      {
        "command": "dnova-copilot.getApiKey",
        "title": "%dnova-copilot.command.getApiKey%"
      },
      {
        "command": "dnova-copilot.clearApiKey",
        "title": "%dnova-copilot.command.clearApiKey%"
      },
      {
        "command": "dnova-copilot.openSettings",
        "title": "%dnova-copilot.command.openSettings%"
      },
      {
        "command": "dnova-copilot.showLogs",
        "title": "%dnova-copilot.command.showLogs%"
      },
      {
        "command": "dnova-copilot.openRequestDumpsFolder",
        "title": "%dnova-copilot.command.openRequestDumpsFolder%"
      },
      {
        "command": "dnova-copilot.setAbapAdtPassword",
        "title": "%dnova-copilot.command.setAbapAdtPassword%"
      },
      {
        "command": "dnova-copilot.configureAbapAdtMcp",
        "title": "%dnova-copilot.command.configureAbapAdtMcp%"
      },
      {
        "command": "dnova-copilot.showAbapAdtMcpConfig",
        "title": "%dnova-copilot.command.showAbapAdtMcpConfig%"
      },
      {
        "command": "dnova-copilot.checkAbapAdtMcp",
        "title": "%dnova-copilot.command.checkAbapAdtMcp%"
      },
      {
        "command": "dnova-copilot.createAbapAgentGuide",
        "title": "%dnova-copilot.command.createAbapAgentGuide%"
      },
      {
        "command": "dnova-copilot.removeAbapAgentGuide",
        "title": "%dnova-copilot.command.removeAbapAgentGuide%"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/dnova-abap-adt/SKILL.md"
      }
    ],
    "walkthroughs": [
      {
        "id": "dnovaGettingStarted",
        "title": "%dnova-copilot.walkthrough.title%",
        "description": "%dnova-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%dnova-copilot.walkthrough.setApiKey.title%",
            "description": "%dnova-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:dnova-copilot.setApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%dnova-copilot.walkthrough.showModels.title%",
            "description": "%dnova-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%dnova-copilot.walkthrough.advancedSettings.title%",
            "description": "%dnova-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%dnova-copilot.config.title%",
      "properties": {
        "dnova-copilot.baseUrl": {
          "type": "string",
          "default": "https://nova.deloitte.com.cn/del/v1",
          "description": "%dnova-copilot.config.baseUrl.description%"
        },
        "dnova-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%dnova-copilot.config.maxTokens.description%"
        },
        "dnova-copilot.modelIdOverrides": {
          "type": "object",
          "default": {
            "glm-5.2": "glm-5.2"
          },
          "description": "%dnova-copilot.config.modelIdOverrides.description%",
          "additionalProperties": false,
          "properties": {
            "glm-5.2": {
              "type": "string",
              "description": "%dnova-copilot.config.modelIdOverrides.glm-5.2.description%"
            }
          }
        },
        "dnova-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%dnova-copilot.config.debugMode.minimal.label%",
            "%dnova-copilot.config.debugMode.metadata.label%",
            "%dnova-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%dnova-copilot.config.debugMode.minimal.description%",
            "%dnova-copilot.config.debugMode.metadata.description%",
            "%dnova-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%dnova-copilot.config.debugMode.description%"
        },
        "dnova-copilot.mcp.abapAdt.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%dnova-copilot.config.mcp.abapAdt.enabled.description%"
        },
        "dnova-copilot.mcp.abapAdt.httpEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%dnova-copilot.config.mcp.abapAdt.httpEnabled.description%"
        },
        "dnova-copilot.mcp.abapAdt.httpHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "%dnova-copilot.config.mcp.abapAdt.httpHost.description%"
        },
        "dnova-copilot.mcp.abapAdt.httpPort": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "%dnova-copilot.config.mcp.abapAdt.httpPort.description%"
        },
        "dnova-copilot.mcp.abapAdt.startupCheck": {
          "type": "boolean",
          "default": true,
          "description": "%dnova-copilot.config.mcp.abapAdt.startupCheck.description%"
        },
        "dnova-copilot.mcp.abapAdt.url": {
          "type": "string",
          "default": "",
          "description": "%dnova-copilot.config.mcp.abapAdt.url.description%",
          "examples": [
            "https://my-sap-system.example.com:8000"
          ]
        },
        "dnova-copilot.mcp.abapAdt.client": {
          "type": "string",
          "default": "100",
          "description": "%dnova-copilot.config.mcp.abapAdt.client.description%"
        },
        "dnova-copilot.mcp.abapAdt.username": {
          "type": "string",
          "default": "",
          "description": "%dnova-copilot.config.mcp.abapAdt.username.description%"
        },
        "dnova-copilot.mcp.abapAdt.password": {
          "type": "string",
          "default": "",
          "description": "%dnova-copilot.config.mcp.abapAdt.password.description%",
          "markdownDescription": "%dnova-copilot.config.mcp.abapAdt.password.markdownDescription%"
        },
        "dnova-copilot.mcp.abapAdt.useSecretStorage": {
          "type": "boolean",
          "default": false,
          "description": "%dnova-copilot.config.mcp.abapAdt.useSecretStorage.description%"
        },
        "dnova-copilot.mcp.abapAdt.envPath": {
          "type": "string",
          "default": "",
          "description": "%dnova-copilot.config.mcp.abapAdt.envPath.description%",
          "examples": [
            "/Users/luke/Documents/CodeSpace/SAP-Fiori/.env"
          ]
        },
        "dnova-copilot.mcp.abapAdt.language": {
          "type": "string",
          "default": "EN",
          "description": "%dnova-copilot.config.mcp.abapAdt.language.description%",
          "examples": [
            "EN",
            "ZH"
          ]
        },
        "dnova-copilot.mcp.abapAdt.systemType": {
          "type": "string",
          "default": "onprem",
          "enum": [
            "onprem",
            "cloud",
            "legacy"
          ],
          "enumDescriptions": [
            "%dnova-copilot.config.mcp.abapAdt.systemType.onprem.description%",
            "%dnova-copilot.config.mcp.abapAdt.systemType.cloud.description%",
            "%dnova-copilot.config.mcp.abapAdt.systemType.legacy.description%"
          ],
          "description": "%dnova-copilot.config.mcp.abapAdt.systemType.description%"
        },
        "dnova-copilot.mcp.abapAdt.authType": {
          "type": "string",
          "default": "basic",
          "enum": [
            "basic",
            "jwt"
          ],
          "enumDescriptions": [
            "%dnova-copilot.config.mcp.abapAdt.authType.basic.description%",
            "%dnova-copilot.config.mcp.abapAdt.authType.jwt.description%"
          ],
          "description": "%dnova-copilot.config.mcp.abapAdt.authType.description%"
        },
        "dnova-copilot.mcp.abapAdt.exposition": {
          "type": "string",
          "default": "readonly",
          "enum": [
            "readonly",
            "readonly,high",
            "readonly,low",
            "high",
            "low",
            "compact"
          ],
          "description": "%dnova-copilot.config.mcp.abapAdt.exposition.description%"
        },
        "dnova-copilot.abap.agentGuide.autoCreate": {
          "type": "boolean",
          "default": true,
          "description": "%dnova-copilot.config.abap.agentGuide.autoCreate.description%"
        },
        "dnova-copilot.abap.agentGuide.file": {
          "type": "string",
          "default": "AGENTS.md",
          "description": "%dnova-copilot.config.abap.agentGuide.file.description%",
          "examples": [
            "AGENTS.md",
            ".github/copilot-instructions.md"
          ]
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true, maxRetries: process.platform === 'win32' ? 10 : 0 })\"",
    "vscode:prepublish": "bash .github/scripts/prepare-marketplace-readme.sh && npm run bundle",
    "compile": "npm run clean && tsc -p ./",
    "watch": "npm run clean && tsc -watch -p ./",
    "bundle": "npm run clean && esbuild src/extension.ts --bundle --outfile=out/extension.js --minify --format=cjs --platform=node --external:vscode && esbuild src/runtime/abapFacade.ts --bundle --outfile=out/abapFacade.js --minify --format=cjs --platform=node",
    "lint": "oxlint",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "package": "vsce package --readme-path dist/README.marketplace.md -o dist/",
    "login": "vsce login luke",
    "publish": "npm run package && vsce publish --readme-path dist/README.marketplace.md"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "ovsx": "0.10.12",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@mcp-abap-adt/core": "^8.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
